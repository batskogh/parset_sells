# Шлях до файлу БД (SQLite)
DB_PATH=data/prices.db

# Скільки сайтів парсяться одночасно (всередині одного сайту — завжди послідовно)
MAX_CONCURRENT_SITES=5

# Глобальні дефолти затримок між запитами (секунди), парсер може перевизначити
DEFAULT_MIN_DELAY=1.0
DEFAULT_MAX_DELAY=3.0

# HTTP
HTTP_TIMEOUT=20
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF=2.0

# Записувати нову ціну лише якщо вона змінилась з останнього разу
STORE_PRICE_ONLY_ON_CHANGE=false

# Веб-інтерфейс
WEB_HOST=127.0.0.1
WEB_PORT=8010

LOG_LEVEL=INFO

# --- Telegram ---
# Токен бота від @BotFather (виглядає як 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Chat ID для службових повідомлень (свій — дізнатись у @userinfobot)
TELEGRAM_CHAT_ID=

# --- Детектор знижки ---
# «Реальна» знижка — падіння нижче моди всієї історії ціни більш ніж на стільки відсотків
DISCOUNT_MIN_DROP_PERCENT=10
# Скільки днів спостережень має бути в історії, щоб мода взагалі щось означала.
# Саме днів: обхід іде кілька разів на добу, але для моди доба дає одну ціну
DISCOUNT_MIN_SAMPLES=5
# Ширина кошика для моди, у відсотках від типової ціни товару:
# без групування кожна ціна унікальна, і мода вироджується в перше ж значення
DISCOUNT_BUCKET_PERCENT=1.0

# --- Сповіщення ---
# Не турбувати повторно частіше, ніж раз на стільки годин (захист від стрибків ціни)
NOTIFY_COOLDOWN_HOURS=24
# Наскільки відсотків нижче має впасти ціна проти вже надісланої,
# щоб про ту саму знижку сказати вдруге
NOTIFY_DEEPER_PERCENT=10

# --- Заявки на нові магазини ---
# Коли хтось надсилає посилання на магазин, якого парсер не знає, власник
# бота отримує про це повідомлення. Про той самий домен — не частіше, ніж
# раз на стільки годин, скільки б посилань не надійшло
SHOP_REQUEST_COOLDOWN_HOURS=24

# --- Здоров'я магазинів ---
# Скільки діб магазин має мовчати, щоб про це сказали. При обході кожні
# 6 годин дві доби — це вісім пропущених прогонів поспіль: мережева
# заминка стільки не триває, а зламаний парсер триває
HEALTH_SILENT_DAYS=2
# Як часто нагадувати, що магазин досі не читається
HEALTH_REPEAT_HOURS=24

# --- Журнали ---
# Крім stdout (його на сервері збирає journald), лог пишеться у файл:
# logs/<канал>.log, окремий на парсер, розсилку й бота
LOG_TO_FILE=1
LOG_DIR=logs
# Скільки добових файлів тримати після ротації опівночі
LOG_RETENTION_DAYS=14

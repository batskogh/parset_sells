# Шлях до файлу БД (SQLite)
DB_PATH=data/prices.db

# Скільки сайтів парсяться одночасно (всередині одного сайту — завжди послідовно)
MAX_CONCURRENT_SITES=5

# Глобальні дефолти затримок між запитами (секунди), парсер може перевизначити
DEFAULT_MIN_DELAY=1.0
DEFAULT_MAX_DELAY=3.0

# HTTP
HTTP_TIMEOUT=20
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF=2.0

# Записувати нову ціну лише якщо вона змінилась з останнього разу
STORE_PRICE_ONLY_ON_CHANGE=false

# Веб-інтерфейс
WEB_HOST=127.0.0.1
WEB_PORT=8010

LOG_LEVEL=INFO

# --- Telegram ---
# Токен бота від @BotFather (виглядає як 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Chat ID для службових повідомлень (свій — дізнатись у @userinfobot)
TELEGRAM_CHAT_ID=

# --- Детектор знижки ---
# «Реальна» знижка — падіння нижче моди всієї історії ціни більш ніж на стільки відсотків
DISCOUNT_MIN_DROP_PERCENT=10
# Скільки замірів має бути в історії, щоб мода взагалі щось означала
DISCOUNT_MIN_SAMPLES=5
# Ширина кошика для моди, у відсотках від типової ціни товару:
# без групування кожна ціна унікальна, і мода вироджується в перше ж значення
DISCOUNT_BUCKET_PERCENT=1.0

# --- Сповіщення ---
# Не турбувати повторно частіше, ніж раз на стільки годин (захист від стрибків ціни)
NOTIFY_COOLDOWN_HOURS=24
# Наскільки відсотків нижче має впасти ціна проти вже надісланої,
# щоб про ту саму знижку сказати вдруге
NOTIFY_DEEPER_PERCENT=10

[Unit]
Description=Обхід магазинів кожні 6 годин

[Timer]
# Чотири рази на добу: 00:00, 06:00, 12:00, 18:00.
# Знижка живе годинами, а не тижнями — при щоденному обході половину з них
# видно вже постфактум. Шість годин — компроміс між свіжістю і чемністю до
# магазину: чотири звернення на добу за товаром не навантажують нікого.
OnCalendar=*-*-* 00/6:00:00

# Рівний ритм секунда в секунду виглядає як робот; розкид робить обхід
# схожим на людину. Двадцять хвилин, а не півгодини, щоб між обходом і
# розсилкою лишався запас
RandomizedDelaySec=20min

# Якщо сервер був вимкнений у момент запуску — наздогнати при старті
Persistent=true

[Install]
WantedBy=timers.target

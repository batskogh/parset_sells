[Unit]
Description=Щоденний обхід магазинів о 7:00

[Timer]
OnCalendar=*-*-* 07:00:00
# Ціни не змінюються посекундно, а рівний ритм запитів виглядає як робот:
# розкид у пів години і дешевший для магазину, і природніший
RandomizedDelaySec=30min
# Якщо сервер був вимкнений у момент запуску — наздогнати при старті
Persistent=true

[Install]
WantedBy=timers.target

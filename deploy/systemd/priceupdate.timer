[Unit]
Description=Щогодинна перевірка оновлень коду

[Timer]
# О сороковій хвилині щогодини: обхід магазинів на той час уже завершений
# (він стартує на початку години й обмежений півгодиною), а якщо раптом ще
# триває — скрипт сам відкладе оновлення до наступного разу.
OnCalendar=*-*-* *:40:00
RandomizedDelaySec=5min

# Наздоганяти пропущене не треба: код нікуди не дінеться, а прокинутись
# оновленням одразу після ввімкнення машини — зайвий ризик
Persistent=false

[Install]
WantedBy=timers.target

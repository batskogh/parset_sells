[Unit]
Description=Розсилка сповіщень кожні 6 годин

[Timer]
# Через годину після обходу: 01:00, 07:00, 13:00, 19:00.
# Година — це з запасом: обхід стартує не пізніше 00:20 і обмежений
# півгодиною (TimeoutStartSec у priceparse.service).
OnCalendar=*-*-* 01/6:00:00
RandomizedDelaySec=10min

# Розсилка навмисно не залежить від успіху обходу. Якщо парсинг спізнився
# чи впав, свіжі знижки почекають наступного кола — тобто шість годин, а не
# добу. Про вже надіслане мовчить журнал сповіщень, тож частіші прогони не
# перетворюються на спам.
Persistent=true

[Install]
WantedBy=timers.target

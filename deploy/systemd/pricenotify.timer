[Unit]
Description=Розсилка сповіщень у денні години

[Timer]
# 07:00, 13:00, 19:00 — через годину після обходів о 06, 12 і 18.
# Годину взято з запасом: обхід стартує не пізніше ніж за 20 хвилин після
# початку години й обмежений півгодиною (TimeoutStartSec у priceparse.service).
#
# Нічного прогону тут немає навмисно. Обхід іде цілодобово — магазинам
# байдуже, котра година, — але знижка, знайдена о третій ночі, о сьомій ранку
# нікуди не подінеться: вона триває днями. Нічне сповіщення нічого не рятує,
# зате будить. Те, що знайшов нічний обхід, надішле ранкова розсилка.
#
# Другий замок на ті самі двері — тихі години в самому коді
# (NOTIFY_QUIET_FROM/TO): вони діють і при запуску руками.
OnCalendar=*-*-* 07,13,19:00:00
RandomizedDelaySec=10min

# УВАГА: час тут місцевий, а типовий контейнер Linux стоїть у UTC. Перевірте
# `timedatectl` — інакше «07:00» настане для Києва о десятій ранку.
Persistent=true

[Install]
WantedBy=timers.target
